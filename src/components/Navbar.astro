---
import LanguageSwitcher from "./LanguageSwitcher.astro";

import type { Locale } from "../i18n";

type CommonTranslation = {
  nav: {
    about: string;
    projects: string;
    contact: string;
  };
};

interface Props {
  lang: Locale;
  common: CommonTranslation;
}

const {
  lang,
  common,
} = Astro.props;

const pathname = Astro.url.pathname;

function href(path: string) {
  return `/${lang}/${path}/`;
}

function isActive(path: string) {
  const target = href(path);

  return (
    pathname === target ||
    pathname.startsWith(target)
  );
}

function navClass(path: string) {
  return [
    "nav-link",
    isActive(path) && "nav-active",
  ];
}

function mobileClass(path: string) {
  return [
    "nav-link",
    isActive(path) && "nav-active",
  ];
}
---

<header
  class="fixed left-0 right-0 top-0 z-50 border-b border-light/8 bg-dark-muted/85 backdrop-blur-xl"
>
  <nav class="container flex h-20 items-center justify-between">

    <!-- Logo -->
    <a
      href={`/${lang}/`}
      class="text-xl font-extrabold tracking-tight inline-flex items-center"
    >
      <span class="text-light">JIANTAO</span>
      <span class="text-navy-muted">.dev</span>
    </a>

    <!-- Desktop -->
    <div class="hidden items-center gap-7 md:flex">
      <a
        href={href("about")}
        class:list={navClass("about")}
        aria-current={
          isActive("about") ? "page" : undefined
        }
      >
        {common.nav.about}
      </a>

      <a
        href={href("projects")}
        class:list={navClass("projects")}
        aria-current={
          isActive("projects") ? "page" : undefined
        }
      >
        {common.nav.projects}
      </a>

      <a
        href="https://www.linkedin.com/in/jiantaoshen/"
        class="btn btn-primary justify-center"
      >
        {common.nav.contact}
      </a>

      <LanguageSwitcher lang={lang} />
    </div>

    <!-- Mobile -->
    <details class="mobile-navigation md:hidden">
      <summary
        class="menu-button"
        aria-label="Toggle navigation"
      >
        <span class="menu-open-icon flex flex-col gap-1.5">
          <span class="h-0.5 w-5 rounded-full bg-light"></span>
          <span class="h-0.5 w-5 rounded-full bg-light"></span>
          <span class="h-0.5 w-5 rounded-full bg-light"></span>
        </span>

        <span
          class="menu-close-icon text-xl leading-none"
          aria-hidden="true"
        >
          ×
        </span>
      </summary>

      <div class="menu-list">
        <div class="container flex flex-col py-4">
          <a
            href={href("about")}
            class:list={mobileClass("about")}
          >
            {common.nav.about}
          </a>

          <a
            href={href("projects")}
            class:list={mobileClass("projects")}
          >
            {common.nav.projects}
          </a>

          <div class="mt-5 flex flex-col gap-3">
            <LanguageSwitcher lang={lang} />

            <a
              href="https://www.linkedin.com/in/jiantaoshen/"
              class="btn btn-primary justify-center"
            >
              {common.nav.contact}
            </a>
          </div>
        </div>
      </div>
    </details>
  </nav>
</header>