---
import type { Locale } from "../i18n";

type CommonTranslation = {
  rights: string;
};

interface Props {
  lang: Locale;
  common: CommonTranslation;
}

const {
  common,
} = Astro.props;

const year = new Date().getFullYear();
---

<footer
  class="border-t border-light-muted bg-dark text-slate-muted"
>
  <div
    class="container flex flex-col gap-5 py-8 sm:flex-row sm:items-center sm:justify-between"
  >
    <div class="flex items-center gap-5">

      <!-- GitHub -->
      <a
        href="https://github.com/jiantaoshen"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
        class="transition duration-200 hover:opacity-100"
      >
        <img
          src="/icons/Github.svg"
          alt=""
          class="h-7 w-7 object-contain opacity-70"
        />
      </a>

      <!-- LinkedIn -->
      <a
        href="https://www.linkedin.com/in/jiantaoshen/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
        class="transition duration-200 hover:opacity-100"
      >
        <img
          src="/icons/Linkedin.svg"
          alt=""
          class="h-7 w-7 object-contain opacity-70"
        />
      </a>
    </div>

    <p class="text-sm text-slate-muted">
      © {year} JIANTAO. {common.rights}
    </p>
  </div>
</footer>