---
import type { Locale } from "../i18n";

import type {
  HomeTranslation,
  CommonTranslation,
  AboutTranslation,
} from "../i18n/types";

interface Props {
  lang: Locale;
  home: HomeTranslation;
  common: CommonTranslation;
  skills: AboutTranslation["skills"];
}

const {
  home,
  common,
  skills,
} = Astro.props;
---

<section id="about" class="hero-shell">
  <div class="container">
    <div class="hero-grid">
      <div class="hero-copy">
        <h1 class="hero-title">
          {home.hero.titleBefore}
          {" "}
          <span class="text-role-blue">
            {home.hero.titleHighlight}
          </span>
        </h1>

        <p class="hero-description">
          {home.hero.description}
        </p>

        <div class="hero-actions">
          <a href="#projects" class="btn btn-primary">
            {common.buttons.viewWork}
            <span aria-hidden="true">→</span>
          </a>

          <a
            href="https://github.com/jiantaoshen"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline"
          >
            GitHub
            <span aria-hidden="true">↗</span>
          </a>

          <a
            href="https://www.linkedin.com/in/jiantaoshen"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline"
          >
            LinkedIn
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <aside
        class="hero-skills"
        aria-labelledby="hero-skills-title"
      >
        <h2
          id="hero-skills-title"
          class="skills-heading hero-skills-heading"
        >
          {skills.title}
        </h2>

        <div class="skill-groups">
          {skills.items.map((group) => (
            <div class="skill-group">
              <h3>{group.title}</h3>

              <div class="skill-tags">
                {group.items.map((item) => (
                  <span>{item}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </aside>
    </div>
  </div>
</section>