---
import type { Locale } from "../i18n";

import type {
  HomeTranslation,
  CommonTranslation,
} from "../i18n/types";

interface Props {
  lang: Locale;
  home: HomeTranslation;
  common: CommonTranslation;
}

const {
  lang,
  home,
  common,
} = Astro.props;

---

<section class="hero flex min-h-screen items-center">
  <div class="container">
    <div class="mx-auto max-w-2xl text-center">

      <h1 class="text-title max-w-3xl text-light">
        {home.hero.titleBefore}
        {" "}
        <span class="text-navy-muted">
          {home.hero.titleHighlight}
        </span>
      </h1>

      <p class="text-large mx-auto max-w-xl text-slate-muted">
        {home.hero.description}
      </p>

      <div class="mx-auto mt-9 flex flex-wrap justify-center items-center gap-3">
        <a href="#projects" class="btn btn-primary">
          {common.buttons.viewWork}
        </a>
      </div>
    </div>
  </div>
</section>