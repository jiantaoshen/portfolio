---
import BaseLayout from "../../layouts/BaseLayout.astro";

import {
  locales,
  getTranslations,
  type Locale,
} from "../../i18n";

import type {
  AboutTranslation,
  CommonTranslation,
} from "../../i18n/types";

export function getStaticPaths() {
  return locales.map((lang) => ({
    params: { lang },
  }));
}

const lang = Astro.params.lang as Locale;

const about =
  getTranslations<AboutTranslation>(
    lang,
    "about",
  );

const common =
  getTranslations<CommonTranslation>(
    lang,
    "common",
  );
---

<BaseLayout
  lang={lang}
  
>
  <!-- Story -->
  <section class="section bg-light-muted">
    <div class="container">
      <h1 class="text-title text-dark text-center">
        {about.story.title}
      </h1>

      {about.story.paragraphs.map((paragraph) => (
        <p class="text-large text-slate">
          {paragraph}
        </p>
      ))}
    </div>
  </section>

  <!-- Skills -->
  <section class="section bg-light">
    <div class="container">
      <h2 class="text-title text-text text-center">
        {about.skills.title}
      </h2>

      <div class="grid gap-5 md:grid-cols-3">
        {about.skills.items.map((group) => (
          <article class="card p-6">
            <h3 class="text-card-title text-dark">
              {group.title}
            </h3>

            <div class="flex flex-wrap gap-2">
              {group.items.map((item) => (
                <span class="tag">
                  {item}
                </span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

    <!-- Education -->
  <section class="section bg-light-muted">
    <div class="container">
      <h2 class="text-title text-dark text-center">
        {about.education.title}
      </h2>

      <div class="grid gap-5 md:grid-cols-2">
        {about.education.items.map((item) => (
          <article class="card p-6">
            <div class="flex flex-col gap-2">
              <p class="text-sm font-semibold text-role">
                {item.period}
              </p>

              <h3 class="text-card-title text-dark">
                {item.degree}
              </h3>

              <p class="text-base font-medium text-slate">
                {item.school}
              </p>

              {item.description && (
                <p class="leading-7 text-slate">
                  {item.description}
                </p>
              )}

              {item.thesis && (
                <p class="mt-3 text-sm text-slate">
                  <span class="font-semibold text-text">
                    Thesis:
                  </span>{" "}

                  {item.thesisUrl ? (
                    <a
                      href={item.thesisUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1 text-role hover:underline"
                    >
                      {item.thesis}
                      <span aria-hidden="true">↗</span>
                    </a>
                  ) : (
                    item.thesis
                  )}
                </p>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>