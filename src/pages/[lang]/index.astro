---
import BaseLayout from "../../layouts/BaseLayout.astro";

import Hero from "../../components/Hero.astro";
import FeaturedProjects from "../../components/FeaturedProjects.astro";

import {
  locales,
  getTranslations,
  type Locale,
} from "../../i18n";

import type {
  AboutTranslation,
} from "../../i18n/types";

export function getStaticPaths() {
  return locales.map((lang) => ({
    params: { lang },
  }));
}

const lang = Astro.params.lang as Locale;

const home = getTranslations(lang, "home");
const common = getTranslations(lang, "common");
const about = getTranslations<AboutTranslation>(lang, "about");
---

<BaseLayout
  lang={lang}
  title="Jiantao Shen | Backend Software Developer"
  description="A backend developer in Eskilstuna"
>
  <Hero
    lang={lang}
    home={home}
    common={common}
    skills={about.skills}
  />

  <FeaturedProjects
    lang={lang}
    home={home}
    common={common}
  />

</BaseLayout>
