---
import BaseLayout from "../../layouts/BaseLayout.astro";

import { getCollection } from "astro:content";

import { locales, getTranslations, type Locale} from "../../i18n";

import type {ProjectTranslation, CommonTranslation} from "../../i18n/types";

export function getStaticPaths() {
  return locales.map((lang) => ({
    params: { lang },
  }));
}

const lang = Astro.params.lang as Locale;

const project =
  getTranslations<ProjectTranslation>(
    lang,
    "project",
  );

const common =
  getTranslations<CommonTranslation>(
    lang,
    "common",
  );

const projects = (
  await getCollection(
    "projects",
    ({ data }) =>
      !data.draft &&
      data.lang === lang,
  )
).sort(
  (a, b) =>
    a.data.order -
    b.data.order,
);

function getProjectSlug(id: string) {
  const [, ...parts] = id.split("/");
  return parts.join("/");
}
---

<BaseLayout
  lang={lang}
  title={`${project.page.title} | JIANTAO.dev`}
>
  <section class="section bg-light-muted">
    <div class="container">

      <h1 class="text-title text-dark text-center">
        {project.page.title}
      </h1>

      <div class="grid gap-6 lg:grid-cols-2">
        {
          projects.map((item) => {
            const slug =
              getProjectSlug(item.id);

            return (
              <article class="card card-hover flex flex-col p-7">
                <div class="flex items-center justify-between gap-4">
                  <h3 class="text-card-title text-dark">
                    {item.data.title}
                  </h3>

                  <span class="tag">
                    {item.data.status}
                  </span>
                </div>

                <p class="text-body flex-1 text-slate">
                  {item.data.description}
                </p>

                {
                  item.data.technologies.length > 0 && (
                    <div class="flex flex-wrap gap-2">
                      {
                        item.data.technologies.map(
                          (technology) => (
                            <span class="tag">
                              {technology}
                            </span>
                          ),
                        )
                      }
                    </div>
                  )
                }

                <div class="mt-7 border-t border-slate-muted pt-5">
                  <a
                    href={`/${lang}/projects/${slug}/`}
                    class="link-role"
                  >
                    {common.buttons.caseStudy}

                    <span aria-hidden="true">
                      →
                    </span>
                  </a>
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>
</BaseLayout>