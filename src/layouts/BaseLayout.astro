---
import "../styles/global.css";

import Seo from "./Seo.astro";

import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";

import {
  getTranslations,
  type Locale,
} from "../i18n";

type CommonTranslation = {
  nav: {
    about: string;
    projects: string;
    contact: string;
  };

  rights: string;
};

interface Props {
  title?: string;
  description: string;
  lang: Locale;

  image?: string;
  type?: "website" | "article";
  noindex?: boolean;
}

const {
  title = "JIANTAO.dev",
  description,
  lang,
  image,
  type = "website",
  noindex = false,
} = Astro.props;

const common =
  getTranslations<CommonTranslation>(
    lang,
    "common",
  );
---

<!doctype html>

<html lang={lang}>
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <Seo
      title={title}
      description={description}
      image={image}
      type={type}
      noindex={noindex}
    />

    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon-js.svg"
    />

    <Analytics />
    <SpeedInsights />
  </head>

  <body>
    <div class="flex min-h-screen w-full flex-col">
      <Navbar
        lang={lang}
        common={common}
      />

      <main class="flex-1">
        <slot />
      </main>

      <Footer
        lang={lang}
        common={common}
      />
    </div>
  </body>
</html>